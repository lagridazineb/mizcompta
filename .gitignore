# Base de données locale (réplique Turso) : ne doit jamais être commitée.
# Chaque déploiement doit repartir d'une réplique fraîche synchronisée
# depuis Turso, pas d'un instantané figé au moment du commit.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.pre-turso-backup-*
